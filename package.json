{
  "name": "amrutam-telemedicine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-grade telemedicine backend: auth/MFA/RBAC, doctor availability, race-free booking, consultations, prescriptions, audit trails and admin analytics.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "migrate": "node --import tsx src/db/migrate.ts",
    "seed": "node --import tsx scripts/seed.ts",
    "openapi": "node --import tsx --env-file=.env.test scripts/generate-openapi.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --env-file=.env.test --test test/unit/config.test.ts test/unit/crypto.test.ts test/unit/totp.test.ts test/unit/retry.test.ts test/unit/authorization.test.ts",
    "test:integration": "node --import tsx --env-file=.env.test --test test/integration/auth.test.ts test/integration/booking.concurrency.test.ts test/integration/idempotency.test.ts",
    "test:all": "node --import tsx --env-file=.env.test --test test/unit/config.test.ts test/unit/crypto.test.ts test/unit/totp.test.ts test/unit/retry.test.ts test/unit/authorization.test.ts test/integration/auth.test.ts test/integration/booking.concurrency.test.ts test/integration/idempotency.test.ts",
    "test:integration:ci": "node --import tsx --test test/integration/auth.test.ts test/integration/booking.concurrency.test.ts test/integration/idempotency.test.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
