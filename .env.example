# Copy to .env and fill in. Every variable here is read once, in src/config.ts.
# Nothing in this file is a real credential.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---------------------------------------------------------------- database
# Local Docker:  postgresql://amrutam:amrutam@localhost:5432/amrutam
# Neon/managed:  add ?sslmode=require and set DATABASE_SSL=true
DATABASE_URL=postgresql://amrutam:amrutam@localhost:5432/amrutam
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ------------------------------------------------------------------- cache
# Optional. Leave blank to run without Redis: reads go straight to Postgres
# and rate limiting falls back to an in-process counter.
# Upstash and other managed providers use rediss:// (TLS).
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------- secrets
# Generate real values before deploying:
#   JWT_SECRET      openssl rand -base64 48
#   DATA_MASTER_KEY openssl rand -base64 32     (must decode to 32 bytes)
#   IP_HASH_SALT    openssl rand -base64 24
# In production these come from the platform secret store, never from a file.
JWT_SECRET=replace-me-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

DATA_MASTER_KEY=replace-me-with-a-base64-encoded-32-byte-key==
DATA_KEY_ID=k1

IP_HASH_SALT=replace-me-with-a-random-salt

# ---------------------------------------------------------------- behaviour
SLOT_HOLD_MINUTES=5
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
WORKER_ENABLED=true

# ------------------------------------------------------------ observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=amrutam-telemedicine
